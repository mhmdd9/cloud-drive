generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FileStatus {
  PENDING
  PROCESSING
  READY
  REJECTED
}

enum SharePermission {
  VIEW
  DOWNLOAD
  EDIT
}

enum FileEncryptionMode {
  NONE
  CONFIDENTIAL
}

model User {
  id           String        @id @default(uuid(7)) @db.Uuid
  email        String        @unique
  username     String?       @unique
  name         String
  passwordHash String
  active       Boolean       @default(true)
  encryptionPublicKey Json?
  encryptionKeyCreatedAt DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  roles        UserRole[]
  memberships  GroupMember[]
  files        File[]
  shares       FileShare[]
  publicLinks  SharedLink[]
  auditLogs    AuditLog[]
}

model Role {
  id            String             @id @default(uuid(7)) @db.Uuid
  name          String             @unique
  permissions   String[]           @default([])
  users         UserRole[]
  sharePolicies GroupSharePolicy[]
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model Group {
  id            String             @id @default(uuid(7)) @db.Uuid
  name          String             @unique
  members       GroupMember[]
  shares        FileShare[]
  sharePolicies GroupSharePolicy[]
}

model GroupMember {
  groupId String @db.Uuid
  userId  String @db.Uuid
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
}

model File {
  id        String      @id @default(uuid(7)) @db.Uuid
  ownerId   String      @db.Uuid
  owner     User        @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  name      String
  mimeType  String
  size      BigInt
  objectKey String      @unique
  versionId String?
  status    FileStatus  @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  deletedAt DateTime?
  encryptionMode FileEncryptionMode @default(NONE)
  encryptionIv String?
  ownerEncryptedFileKey String?
  originalSize BigInt?
  shares    FileShare[]
  publicLinks SharedLink[]

  @@index([ownerId, createdAt])
  @@index([ownerId, deletedAt])
  @@index([status, createdAt])
}

model FileShare {
  id         String          @id @default(uuid(7)) @db.Uuid
  fileId     String          @db.Uuid
  userId     String?         @db.Uuid
  groupId    String?         @db.Uuid
  permission SharePermission
  expiresAt  DateTime?
  encryptedFileKey String?
  file       File            @relation(fields: [fileId], references: [id], onDelete: Cascade)
  user       User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  group      Group?          @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([fileId])
  @@index([userId, fileId])
  @@index([groupId, fileId])
  @@index([expiresAt])
  @@unique([fileId, userId])
}

model SharedLink {
  id         String          @id @default(uuid(7)) @db.Uuid
  tokenHash  String          @unique
  fileId     String          @db.Uuid
  ownerId    String          @db.Uuid
  permission SharePermission @default(DOWNLOAD)
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime         @default(now())
  file       File             @relation(fields: [fileId], references: [id], onDelete: Cascade)
  owner      User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([fileId])
  @@index([ownerId, createdAt])
  @@index([expiresAt])
}

model GroupSharePolicy {
  groupId String @db.Uuid
  roleId  String @db.Uuid
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  role    Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([groupId, roleId])
  @@index([roleId])
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  actorId    String?  @db.Uuid
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  success    Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
}
